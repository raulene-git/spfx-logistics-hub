{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "shipment-tracker-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/shipmentTracker/ShipmentTrackerWebPart.js",
          "manifest": "./src/webparts/shipmentTracker/ShipmentTrackerWebPart.manifest.json"
        }
      ]
    },
    "fieldnotes-hero-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/fieldnotesHero/FieldnotesHeroWebPart.js",
          "manifest": "./src/webparts/fieldnotesHero/FieldnotesHeroWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "ShipmentTrackerWebPartStrings": "lib/webparts/shipmentTracker/loc/{locale}.js",
    "FieldnotesHeroWebPartStrings": "lib/webparts/fieldnotesHero/loc/{locale}.js"
  }
}
