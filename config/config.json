    "say-hello-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/sayHello/SayHelloWebPart.js",
          "manifest": "./src/webparts/sayHello/SayHelloWebPart.manifest.json"
        }
      ]
    },
    "shipment-importer-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/shipmentImporter/ShipmentImporterWebPart.js",
          "manifest": "./src/webparts/shipmentImporter/ShipmentImporterWebPart.manifest.json"
        }
      ]
    }
