  "externals": {},
  "localizedResources": {
    "ShipmentTrackerWebPartStrings": "lib/webparts/shipmentTracker/loc/{locale}.js",
    "FieldnotesHeroWebPartStrings": "lib/webparts/fieldnotesHero/loc/{locale}.js"
