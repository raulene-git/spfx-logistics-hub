{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "shipment-tracker-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/shipmentTracker/ShipmentTrackerWebPart.js",
          "manifest": "./src/webparts/shipmentTracker/ShipmentTrackerWebPart.manifest.json"
        }
      ]
    },
    "fieldnotes-hero-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/fieldnotesHero/FieldnotesHeroWebPart.js",
          "manifest": "./src/webparts/fieldnotesHero/FieldnotesHeroWebPart.manifest.json"
        }
      ]
    },
    "discover-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/discover/DiscoverWebPart.js",
          "manifest": "./src/webparts/discover/DiscoverWebPart.manifest.json"
        }
      ]
    },
    "callout-band-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/calloutBand/CalloutBandWebPart.js",
          "manifest": "./src/webparts/calloutBand/CalloutBandWebPart.manifest.json"
        }
      ]
    },
    "quick-links-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/quickLinks/QuickLinksWebPart.js",
