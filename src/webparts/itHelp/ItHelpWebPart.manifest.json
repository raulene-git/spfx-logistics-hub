{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "5b0f3c8e-2d47-4a1e-9c63-8f7e2a4d91b6",
  "alias": "ItHelpWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],

  // Uses the Fieldnotes brand colours rather than the section's theme colours.
  "supportsThemeVariants": false,

  // Built as a full-width hero.
  "supportsFullBleed": true,

  "preconfiguredEntries": [{
    "groupId": "aec813ce-7240-4750-9bbd-55ddfb138d5a",
    "group": { "default": "Fieldnotes" },
    "title": { "default": "IT Help" },
    "description": { "default": "Raise an IT ticket from a template. IT staff also get the whole queue, with statuses and worklogs" },
    "iconImageUrl": "data:image/svg+xml;base64,",
    "properties": {
      "title": "How can we",
      "accent": "help?",
      "lede": "Tell us what’s broken or what you need. Pick the closest option and we’ll take it from there.",
      "promise": "Someone will pick it up within one working day.",
      "dataSource": "demo",
      "ticketList": "IT Tickets",
      "worklogList": "IT Worklogs"
    }
  }]
}
