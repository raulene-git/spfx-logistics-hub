{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "11e53601-05eb-4174-8098-98ff97b43ab2",
  "alias": "ShipmentTrackerWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  // If true, the component can only be installed on sites where Custom Script is allowed.
  // Components that allow authors to embed arbitrary script code should set this to true.
  // https://support.office.com/en-us/article/Turn-scripting-capabilities-on-or-off-1f2c515f-5d7e-448a-9fd7-835da935584f
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],

  // Uses the Fieldnotes brand colours rather than the section's theme colours.
  "supportsThemeVariants": false,

  // Lets authors place the board in a full-width section.
  "supportsFullBleed": true,

  // Two entries in the toolbox from one web part: the full board and the snapshot.
  "preconfiguredEntries": [{
    "groupId": "aec813ce-7240-4750-9bbd-55ddfb138d5a",
    "group": { "default": "Fieldnotes" },
    "title": { "default": "Dispatch Board" },
    "description": { "default": "Every consignment and its delivery status, with filters and search" },
    "iconImageUrl": "data:image/svg+xml;base64,",
    "properties": {
      "layout": "board",
      "eyebrow": "",
      "title": "Dispatch",
      "accentWord": "board.",
      "boardUrl": "",
      "dataSource": "demo",
      "listTitle": "Shipments"
    }
  }, {
    "groupId": "aec813ce-7240-4750-9bbd-55ddfb138d5a",
    "group": { "default": "Fieldnotes" },
    "title": { "default": "Board Snapshot" },
    "description": { "default": "Today at a glance: the board's counts and what needs a look, linking to the full board" },
    "iconImageUrl": "data:image/svg+xml;base64,",
    "properties": {
      "layout": "snapshot",
      "eyebrow": "01 / Today at a glance",
      "title": "The day so far.",
      "accentWord": "",
      "boardUrl": "",
      "dataSource": "demo",
      "listTitle": "Shipments"
    }
  }]
}
